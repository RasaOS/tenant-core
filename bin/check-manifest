#!/usr/bin/env python3
"""
bin/check-manifest — verify rasa.json is a complete inventory of the Element, and that it loads as a plugin.

bin/init and /sync are manifest-driven: they install exactly what rasa.json
declares. If a file is committed to content/ or seed/ but never registered
in rasa.json, it silently never ships — and nothing else catches it. This
script does.

Two inventory checks, both directions:
  1. Coverage — every git-tracked file under content/ and seed/ is
     registered in rasa.json (matched by an exact element.files /
     seed.files 'from', or by an ancestor directory entry).
  2. Dangling — every rasa.json 'from' points at a path that exists.

Third check (the loadable plugin, galt ADR 0064): .claude-plugin/plugin.json
exists, parses, is named rasa-<kind>-<name> after rasa.json's name, carries
rasa.json's version, and every component path it declares is a folder that
exists. Without it a session cannot load this Element (it fails closed).

Run it before tagging an Element release, or wire it into CI.

Cross-platform: pure Python standard library — runs the same on macOS and
Windows. Requires python3 and git.

Exit: 0 if the manifest is a complete, accurate inventory; 1 otherwise.
"""

import json
import os
import subprocess
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MANIFEST = os.path.join(REPO_ROOT, "rasa.json")


def die(msg):
    print("ERROR: " + msg, file=sys.stderr)
    sys.exit(1)


# ── preflight ───────────────────────────────────────────────────────────────
if not os.path.isfile(MANIFEST):
    die("rasa.json not found at %s" % MANIFEST)
try:
    subprocess.check_output(
        ["git", "-C", REPO_ROOT, "rev-parse", "--is-inside-work-tree"],
        stderr=subprocess.DEVNULL)
except FileNotFoundError:
    die("bin/check-manifest requires git on PATH.")
except subprocess.CalledProcessError:
    die("bin/check-manifest must run inside the Element's git repo.")

try:
    manifest = json.load(open(MANIFEST))
except (OSError, ValueError) as exc:
    die("could not parse rasa.json: %s" % exc)

# ── the two checks ──────────────────────────────────────────────────────────
# Every 'from' the manifest declares (element-managed + seed), slash-stripped.
froms = []
for section in ("element", "seed"):
    for entry in manifest.get(section, {}).get("files", []):
        froms.append(entry["from"].rstrip("/"))
from_set = set(froms)

# The real inventory: git-tracked files under content/ and seed/.
tracked = subprocess.check_output(
    ["git", "-C", REPO_ROOT, "ls-files", "content", "seed"], text=True
).splitlines()
tracked = [t for t in tracked if t]


def covered(path):
    """True if path equals a 'from', or any ancestor directory is a 'from'."""
    if path in from_set:
        return True
    parts = path.split("/")
    return any("/".join(parts[:i]) in from_set for i in range(1, len(parts)))


uncovered = sorted(p for p in tracked if not covered(p))

# Third check: the loadable plugin manifest.
plugin_problems = []
PLUGIN = os.path.join(REPO_ROOT, ".claude-plugin", "plugin.json")
if not os.path.isfile(PLUGIN):
    plugin_problems.append(".claude-plugin/plugin.json is missing (a session cannot load this Element without it)")
else:
    try:
        plugin = json.load(open(PLUGIN))
    except (OSError, ValueError) as exc:
        plugin = None
        plugin_problems.append(".claude-plugin/plugin.json does not parse: %s" % exc)
    if isinstance(plugin, dict):
        want = str(manifest.get("name", "")).replace(".", "-")
        if plugin.get("name") != want:
            plugin_problems.append("plugin.json name is %r, rasa.json says it should be %r" % (plugin.get("name"), want))
        if plugin.get("version") != manifest.get("version"):
            plugin_problems.append("plugin.json version %r differs from rasa.json version %r" % (plugin.get("version"), manifest.get("version")))
        for key in ("skills", "agents", "commands"):
            val = plugin.get(key)
            for rel in ([val] if isinstance(val, str) else val if isinstance(val, list) else []):
                if not os.path.isdir(os.path.join(REPO_ROOT, rel)):
                    plugin_problems.append("plugin.json %s points at %s, which is not a folder" % (key, rel))
dangling = sorted(f for f in froms if not os.path.exists(os.path.join(REPO_ROOT, f)))
problems = len(uncovered) + len(dangling) + len(plugin_problems)

print("bin/check-manifest — rasa.json coverage")
print()

if uncovered:
    print("UNREGISTERED — committed under content/ or seed/, absent from rasa.json:")
    for p in uncovered:
        print("  x  %s" % p)
    print()

if dangling:
    print("DANGLING — a rasa.json 'from' points at a path that does not exist:")
    for f in dangling:
        print("  x  %s" % f)
    print()

if plugin_problems:
    print("PLUGIN — the loadable manifest is wrong:")
    for p in plugin_problems:
        print("  x  %s" % p)
    print()

if problems == 0:
    print("OK   rasa.json is a complete inventory.")
    print("     %d tracked files under content/ + seed/, all registered; plugin.json is loadable." % len(tracked))
    sys.exit(0)

print("FAIL %d problem(s) — rasa.json and the Element tree have drifted." % problems)
sys.exit(1)
